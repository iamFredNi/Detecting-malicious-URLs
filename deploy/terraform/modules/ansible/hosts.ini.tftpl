[honeypot]
honeypot_instance ansible_host=${honeypot_ip_addr} ansible_user=ec2-user ansible_ssh_private_key_file=ssh_private_key ansible_ssh_extra_args='-o StrictHostKeyChecking=no'

[url_crawler]
url_crawler_instance ansible_host=${url_crawler_ip_addr} ansible_user=ec2-user ansible_ssh_private_key_file=ssh_private_key ansible_ssh_extra_args='-o StrictHostKeyChecking=no'
